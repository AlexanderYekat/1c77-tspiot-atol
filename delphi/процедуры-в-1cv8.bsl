// sell / sellReturn — составное задание.
// РезультатыПроверок — итог ОбъединитьРезультатыПроверкиМарок (РезультатыККТ / РезультатыРР).
//
&НаКлиенте
Функция СформироватьЗаданиеЧека(ДанныеЧека, РезультатыПроверок, Настройки = Неопределено) Экспорт
	
	Если Настройки = Неопределено Тогда
		Настройки = ПолучитьНастройки();
	КонецЕсли;
	
	ЭтоВозврат = ЭтоЧекВозврата(ДанныеЧека);
	
	Задание = Новый Структура;
	Задание.Вставить("type", ?(ЭтоВозврат, "sellReturn", "sell"));
	
	Если Настройки.Свойство("СистемаНалогообложения")
		И ЗначениеЗаполнено(Настройки.СистемаНалогообложения) Тогда
		Задание.Вставить("taxationType", КодСистемыНалогообложенияАТОЛ(Настройки.СистемаНалогообложения));
	КонецЕсли;
	
	ИмяКассира = "";
	ИННКассира = "";
	Если ДанныеЧека <> Неопределено Тогда
		Если ДанныеЧека.Свойство("Кассир") Тогда
			ИмяКассира = СокрЛП(Строка(ДанныеЧека.Кассир));
		КонецЕсли;
		Если ДанныеЧека.Свойство("ИННКассира") Тогда
			ИННКассира = СокрЛП(Строка(ДанныеЧека.ИННКассира));
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(ИмяКассира) Тогда
		Задание.Вставить("operator", СтруктураОператораАТОЛ(ИмяКассира, ИННКассира));
	КонецЕсли;
	
	EmailТелефон = "";
	Если ДанныеЧека <> Неопределено И ДанныеЧека.Свойство("EmailТелефон") Тогда
		EmailТелефон = СокрЛП(Строка(ДанныеЧека.EmailТелефон));
	КонецЕсли;
	Если ЗначениеЗаполнено(EmailТелефон) Тогда
		Задание.Вставить("electronically", Истина);
		Клиент = Новый Структура;
		Клиент.Вставить("emailOrPhone", EmailТелефон);
		Задание.Вставить("clientInfo", Клиент);
	КонецЕсли;
	
	ПозицииДанных = Новый Массив;
	Если ДанныеЧека <> Неопределено И ДанныеЧека.Свойство("Позиции") Тогда
		ПозицииДанных = ДанныеЧека.Позиции;
	КонецЕсли;
	Задание.Вставить("items", СформироватьПозицииЧека(ПозицииДанных, РезультатыПроверок, ЭтоВозврат));
	Задание.Вставить("payments", СформироватьОплатыЧека(ДанныеЧека));
	
	Возврат Задание;
	
КонецФункции

&НаКлиенте
