// Массив items для sell / sellReturn.
//
&НаКлиенте
Функция СформироватьПозицииЧека(Позиции, РезультатыПроверок, ЭтоВозврат = Ложь) Экспорт
	
	ЭлементыЧека = Новый Массив;
	
	Если Позиции = Неопределено Тогда
		Возврат ЭлементыЧека;
	КонецЕсли;
	
	Для Каждого Позиция Из Позиции Цикл
		ЭлементыЧека.Добавить(СформироватьПозициюЧека(Позиция, РезультатыПроверок, ЭтоВозврат));
	КонецЦикла;
	
	Возврат ЭлементыЧека;
	
КонецФункции

// Одна позиция чека (type = position).
//
&НаКлиенте
Функция СформироватьПозициюЧека(Позиция, РезультатыПроверок, ЭтоВозврат = Ложь) Экспорт
	
	СтрокаПозиции = Новый Структура;
	СтрокаПозиции.Вставить("type", "position");
	
	Наименование = "";
	Если Позиция.Свойство("Наименование") Тогда
		Наименование = СокрЛП(Строка(Позиция.Наименование));
	КонецЕсли;
	СтрокаПозиции.Вставить("name", Наименование);
	
	Цена = 0;
	Если Позиция.Свойство("Цена") Тогда
		Цена = Позиция.Цена;
	КонецЕсли;
	
	Количество = 1;
	Если Позиция.Свойство("Количество") Тогда
		Количество = Позиция.Количество;
	КонецЕсли;
	
	Сумма = Цена * Количество;
	Если Позиция.Свойство("Сумма") И ЗначениеЗаполнено(Позиция.Сумма) Тогда
		Сумма = Позиция.Сумма;
	КонецЕсли;
	
	СтрокаПозиции.Вставить("price", Цена);
	СтрокаПозиции.Вставить("quantity", Количество);
	СтрокаПозиции.Вставить("amount", Сумма);
	СтрокаПозиции.Вставить("measurementUnit", "0");
	СтрокаПозиции.Вставить("paymentMethod", "fullPayment");
	СтрокаПозиции.Вставить("paymentObject", ПолучитьТипПредметаРасчетаАТОЛ(
			?(Позиция.Свойство("ТипПозиции"), Позиция.ТипПозиции, ""),
			ЭтоМаркированнаяПозиция(Позиция)));
	
	СтавкаНДС = "none";
	Если Позиция.Свойство("СтавкаНДС") И ЗначениеЗаполнено(Позиция.СтавкаНДС) Тогда
		СтавкаНДС = Позиция.СтавкаНДС;
	КонецЕсли;
	Налог = Новый Структура;
	Налог.Вставить("type", ПолучитьСтавкуНДСАТОЛ(СтавкаНДС));
	СтрокаПозиции.Вставить("tax", Налог);
	
	Если ЭтоМаркированнаяПозиция(Позиция) Тогда
		
		МаркаBase64 = Позиция.КодМаркировки;
		РезультатККТ = НайтиРезультатПроверкиККТПоМарке(РезультатыПроверок, МаркаBase64);
		РезультатРР = НайтиРезультатПроверкиРРПоМарке(РезультатыПроверок, МаркаBase64);
		
		ИтогОтраслевой = СформироватьОтраслевойРеквизитПозиции(РезультатРР);
		Если ИтогОтраслевой <> Неопределено Тогда
			СтрокаПозиции.Вставить("industryInfo", ИтогОтраслевой);
		КонецЕсли;
		
		СтрокаПозиции.Вставить("imcParams",
			СформироватьРеквизитыМаркировки(Позиция, РезультатККТ, ЭтоВозврат));
		
	КонецЕсли;
	
	Возврат СтрокаПозиции;
	
КонецФункции

// imcParams позиции (ФФД ≥ 1.2): код КМ + результат предварительной проверки ККТ.
//
&НаКлиенте
Функция СформироватьРеквизитыМаркировки(Позиция, РезультатККТ, ЭтоВозврат = Ложь) Экспорт
	
	ПланируемыйСтатус = "itemPieceSold";
	Если РезультатККТ <> Неопределено
		И РезультатККТ.Свойство("ПланируемыйСтатусМарки")
		И ЗначениеЗаполнено(РезультатККТ.ПланируемыйСтатусМарки) Тогда
		ПланируемыйСтатус = РезультатККТ.ПланируемыйСтатусМарки;
	Иначе
		ЭтоРозливнойТовар = Ложь;
		РозливнойТоварОстатки = Ложь;
		Если Позиция.Свойство("ЭтоРозливнойТовар") Тогда
			ЭтоРозливнойТовар = Позиция.ЭтоРозливнойТовар;
		КонецЕсли;
		Если Позиция.Свойство("РозливнойТоварОстатки") Тогда
			РозливнойТоварОстатки = Позиция.РозливнойТоварОстатки;
		КонецЕсли;
		ПланируемыйСтатус = ПолучитьПланируемыйСтатусМарки(ЭтоВозврат, ЭтоРозливнойТовар, РозливнойТоварОстатки);
	КонецЕсли;
	
	ПараметрыМарки = Новый Структура;
	ПараметрыМарки.Вставить("imcType", "auto");
	ПараметрыМарки.Вставить("imc", Позиция.КодМаркировки);
	ПараметрыМарки.Вставить("itemEstimatedStatus", ПланируемыйСтатус);
	ПараметрыМарки.Вставить("imcModeProcessing", 0);
	ПараметрыМарки.Вставить("itemInfoCheckResult",
		СведенияОПроверкеМаркиИзРезультатаККТ(РезультатККТ));
	
	Возврат ПараметрыМарки;
	
КонецФункции

// itemInfoCheckResult из JSON ответа getMarkingCodeValidationStatus.
// Если JSON нет — флаги false (как при [M] / отсутствии проверки).
//
&НаКлиенте
Функция СведенияОПроверкеМаркиИзРезультатаККТ(РезультатККТ)
	
	Сведения = Новый Структура;
	Сведения.Вставить("imcCheckFlag", Ложь);
	Сведения.Вставить("imcCheckResult", Ложь);
	Сведения.Вставить("imcStatusInfo", Ложь);
	Сведения.Вставить("imcEstimatedStatusCorrect", Ложь);
	Сведения.Вставить("ecrStandAloneFlag", Ложь);
	
	Если РезультатККТ = Неопределено
		ИЛИ НЕ РезультатККТ.Свойство("JSONРезультатаПроверки")
		ИЛИ НЕ ЗначениеЗаполнено(РезультатККТ.JSONРезультатаПроверки) Тогда
		Возврат Сведения;
	КонецЕсли;
	
	Попытка
		Ответ = ПрочитатьJSONВСтруктуру(РезультатККТ.JSONРезультатаПроверки);
	Исключение
		Возврат Сведения;
	КонецПопытки;
	
	Если Ответ = Неопределено
		ИЛИ НЕ Ответ.Свойство("onlineValidation")
		ИЛИ НЕ Ответ.onlineValidation.Свойство("itemInfoCheckResult") Тогда
		Возврат Сведения;
	КонецЕсли;
	
	ИзОтвета = Ответ.onlineValidation.itemInfoCheckResult;
	Если ИзОтвета.Свойство("imcCheckFlag") Тогда
		Сведения.imcCheckFlag = ИзОтвета.imcCheckFlag;
	КонецЕсли;
	Если ИзОтвета.Свойство("imcCheckResult") Тогда
		Сведения.imcCheckResult = ИзОтвета.imcCheckResult;
	КонецЕсли;
	Если ИзОтвета.Свойство("imcStatusInfo") Тогда
		Сведения.imcStatusInfo = ИзОтвета.imcStatusInfo;
	КонецЕсли;
	Если ИзОтвета.Свойство("imcEstimatedStatusCorrect") Тогда
		Сведения.imcEstimatedStatusCorrect = ИзОтвета.imcEstimatedStatusCorrect;
	ИначеЕсли Ответ.onlineValidation.Свойство("markOperatorItemStatus") Тогда
		Сведения.imcEstimatedStatusCorrect =
			Ответ.onlineValidation.markOperatorItemStatus = "itemEstimatedStatusCorrect";
	КонецЕсли;
	Если ИзОтвета.Свойство("ecrStandAloneFlag") Тогда
		Сведения.ecrStandAloneFlag = ИзОтвета.ecrStandAloneFlag;
	КонецЕсли;
	
	Возврат Сведения;
	
КонецФункции

// Отраслевой реквизит РР (тег 1260): реквизиты ППР 1944 + UUID/Time[/Inst/Ver].
//
&НаКлиенте
Функция СформироватьОтраслевойРеквизитПозиции(РезультатРР) Экспорт
	
	Если РезультатРР = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	UUIDРР = "";
	Если РезультатРР.Свойство("UUIDРР") Тогда
		UUIDРР = СокрЛП(Строка(РезультатРР.UUIDРР));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(UUIDРР) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	TimeStamp = "";
	Если РезультатРР.Свойство("TimeStamp") Тогда
		TimeStamp = СокрЛП(Строка(РезультатРР.TimeStamp));
	КонецЕсли;
	
	Реквизит = "UUID=" + UUIDРР + "&Time=" + TimeStamp;
	
	Inst = "";
	Если РезультатРР.Свойство("Inst") Тогда
		Inst = СокрЛП(Строка(РезультатРР.Inst));
	КонецЕсли;
	Version = "";
	Если РезультатРР.Свойство("Version") Тогда
		Version = СокрЛП(Строка(РезультатРР.Version));
	КонецЕсли;
	Если ЗначениеЗаполнено(Inst) Тогда
		Реквизит = Реквизит + "&Inst=" + Inst + "&Ver=" + Version;
	КонецЕсли;
	
	Элемент = Новый Структура;
	Элемент.Вставить("fois", "030");
	Элемент.Вставить("date", "21.11.2023");
	Элемент.Вставить("number", "1944");
	Элемент.Вставить("industryAttribute", Реквизит);
	
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить(Элемент);
	Возврат МассивРеквизитов;
	
КонецФункции

// Массив payments: cash / electronically (по полям формы).
//
&НаКлиенте
Функция СформироватьОплатыЧека(ДанныеЧека) Экспорт
	
	Оплаты = Новый Массив;
	
	Если ДанныеЧека = Неопределено Тогда
		Возврат Оплаты;
	КонецЕсли;
	
	ОплатаНаличными = 0;
	Если ДанныеЧека.Свойство("ОплатаНаличными") Тогда
		ОплатаНаличными = ДанныеЧека.ОплатаНаличными;
	КонецЕсли;
	Если ОплатаНаличными > 0 Тогда
		Оплата = Новый Структура;
		Оплата.Вставить("type", "cash");
		Оплата.Вставить("sum", ОплатаНаличными);
		Оплаты.Добавить(Оплата);
	КонецЕсли;
	
	ОплатаКартой = 0;
	Если ДанныеЧека.Свойство("ОплатаКартой") Тогда
		ОплатаКартой = ДанныеЧека.ОплатаКартой;
	КонецЕсли;
	Если ОплатаКартой > 0 Тогда
		Оплата = Новый Структура;
		Оплата.Вставить("type", "electronically");
		Оплата.Вставить("sum", ОплатаКартой);
		Оплаты.Добавить(Оплата);
	КонецЕсли;
	
	Возврат Оплаты;
	
КонецФункции

// Ставка НДС → код tax.type АТОЛ.
//
&НаКлиенте
Функция ПолучитьСтавкуНДСАТОЛ(СтавкаНДС) Экспорт
	
	Текст = НРег(СокрЛП(Строка(СтавкаНДС)));
	
	Если Текст = "" ИЛИ Текст = "none" ИЛИ Текст = "без ндс" ИЛИ Текст = "безндс" Тогда
		Возврат "none";
	ИначеЕсли Текст = "vat20" ИЛИ Текст = "20%" ИЛИ Текст = "20" Тогда
		Возврат "vat20";
	ИначеЕсли Текст = "vat22" ИЛИ Текст = "22%" ИЛИ Текст = "22" Тогда
		Возврат "vat22";
	ИначеЕсли Текст = "vat10" ИЛИ Текст = "10%" ИЛИ Текст = "10" Тогда
		Возврат "vat10";
	ИначеЕсли Текст = "vat5" ИЛИ Текст = "5%" ИЛИ Текст = "5" Тогда
		Возврат "vat5";
	ИначеЕсли Текст = "vat7" ИЛИ Текст = "7%" ИЛИ Текст = "7" Тогда
		Возврат "vat7";
	ИначеЕсли Текст = "vat0" ИЛИ Текст = "0%" ИЛИ Текст = "0" Тогда
		Возврат "vat0";
	ИначеЕсли Текст = "vat120" Тогда
		Возврат "vat120";
	ИначеЕсли Текст = "vat110" Тогда
		Возврат "vat110";
	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

// Тип позиции формы → paymentObject АТОЛ (ФФД ≥ 1.1 / 1.2).
// Для маркированных — commodityWithMarking / exciseWithMarking;
// без марки — commodity (дефолт ФФД ≥ 1.1) либо service / payment.
//
&НаКлиенте
Функция ПолучитьТипПредметаРасчетаАТОЛ(ТипПозиции, ЕстьКодМаркировки = Ложь) Экспорт
	
	Текст = НРег(СокрЛП(Строка(ТипПозиции)));
	
	// Уже готовые коды/имена АТОЛ — пропускаем как есть.
	Если Текст = "commoditywithmarking" ИЛИ Текст = "33" Тогда
		Возврат "commodityWithMarking";
	ИначеЕсли Текст = "commoditywithoutmarking" ИЛИ Текст = "32" Тогда
		Возврат "commodityWithoutMarking";
	ИначеЕсли Текст = "excisewithmarking" ИЛИ Текст = "31" Тогда
		Возврат "exciseWithMarking";
	ИначеЕсли Текст = "excisewithoutmarking" ИЛИ Текст = "30" Тогда
		Возврат "exciseWithoutMarking";
	ИначеЕсли Текст = "commodity" ИЛИ Текст = "1" Тогда
		Возврат "commodity";
	ИначеЕсли Текст = "excise" ИЛИ Текст = "2" Тогда
		Возврат "excise";
	ИначеЕсли Текст = "job" ИЛИ Текст = "3" Тогда
		Возврат "job";
	ИначеЕсли Текст = "услуга" ИЛИ Текст = "service" ИЛИ Текст = "4" Тогда
		Возврат "service";
	ИначеЕсли Текст = "платеж" ИЛИ Текст = "payment" ИЛИ Текст = "10" Тогда
		Возврат "payment";
	КонецЕсли;
	
	ЭтоПодакцизный = СтрНайти(Текст, "подакциз") > 0
		ИЛИ СтрНайти(Текст, "excise") > 0;
	ЕстьМарка = ЕстьКодМаркировки
		ИЛИ Текст = "маркированный"
		ИЛИ Текст = "маркированныйтовар";
	
	Если ЭтоПодакцизный Тогда
		Возврат ?(ЕстьМарка, "exciseWithMarking", "exciseWithoutMarking");
	КонецЕсли;
	
	Если ЕстьМарка Тогда
		Возврат "commodityWithMarking";
	КонецЕсли;
	
	// Товар / пусто: ФФД ≥ 1.1 — commodity.
	Возврат "commodity";
	
КонецФункции

&НаКлиенте
Функция НайтиРезультатПроверкиККТПоМарке(РезультатыПроверок, МаркаBase64)
	
	Если РезультатыПроверок = Неопределено
		ИЛИ НЕ ЗначениеЗаполнено(МаркаBase64)
		ИЛИ НЕ РезультатыПроверок.Свойство("РезультатыККТ") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого Элемент Из РезультатыПроверок.РезультатыККТ Цикл
		Если Элемент.Свойство("МаркаBase64") И Элемент.МаркаBase64 = МаркаBase64 Тогда
			Если Элемент.Свойство("Результат") Тогда
				Возврат Элемент.Результат;
			КонецЕсли;
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция НайтиРезультатПроверкиРРПоМарке(РезультатыПроверок, МаркаBase64)
	
	Если РезультатыПроверок = Неопределено
