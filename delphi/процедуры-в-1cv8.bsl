// Пакетная проверка марок на ККТ. По всем маркам, без ранней остановки.
//
// Параметры:
//  МассивМарок — массив НовоеОписаниеМаркиДляПроверки (или строк Base64);
//  ЭтоВозврат  — общий для всего чека (sellReturn);
//  Настройки   — Неопределено → ПолучитьНастройки().
//
&НаКлиенте
Функция ПроверитьМаркиНаККТ(МассивМарок, ЭтоВозврат = Ложь, Настройки = Неопределено) Экспорт
	
	Итог = НовыйРезультатПроверкиМарокНаККТ();
	
	Если МассивМарок = Неопределено ИЛИ МассивМарок.Количество() = 0 Тогда
		Итог.ПоВсемМаркамПроведенаПроверка = Истина;
		Итог.ВсеМаркиПриняты = Истина;
		Возврат Итог;
	КонецЕсли;
	
	Если Настройки = Неопределено Тогда
		Настройки = ПолучитьНастройки();
	КонецЕсли;
	
	ВсеПриняты = Истина;
	ЕстьПредупреждения = Ложь;
	ДетальноОписаниеОшибки = "";
	КодОшибкиИтог = 0;
	ВсегоМарок = МассивМарок.Количество();
	НомерМарки = 0;
	
	Для Каждого ЭлементМарки Из МассивМарок Цикл
		
		НомерМарки = НомерМарки + 1;
		Состояние(СтрШаблон("Проверка марок на ККТ… %1 из %2", НомерМарки, ВсегоМарок));
		
		МаркаBase64 = ИзвлечьМаркуBase64(ЭлементМарки);
		ЭтоРозливнойТовар = Ложь;
		РозливнойТоварОстатки = Ложь;
		
		Если ТипЗнч(ЭлементМарки) = Тип("Структура") Тогда
			Если ЭлементМарки.Свойство("ЭтоРозливнойТовар") Тогда
				ЭтоРозливнойТовар = ЭлементМарки.ЭтоРозливнойТовар;
			КонецЕсли;
			Если ЭлементМарки.Свойство("РозливнойТоварОстатки") Тогда
				РозливнойТоварОстатки = ЭлементМарки.РозливнойТоварОстатки;
			КонецЕсли;
		КонецЕсли;
		
		РезультатМарки = ПроверитьМаркуНаККТ(
				МаркаBase64, ЭтоВозврат, ЭтоРозливнойТовар, РозливнойТоварОстатки, Настройки);
		
		Итог.Результаты.Добавить(НовыйЭлементРезультатаПроверкиМаркиНаККТ(МаркаBase64, РезультатМарки));
		
		Если НЕ РезультатМарки.Успех Тогда
			ВсеПриняты = Ложь;
			Если КодОшибкиИтог = 0 И РезультатМарки.КодОшибки <> 0 Тогда
				КодОшибкиИтог = РезультатМарки.КодОшибки;
			КонецЕсли;
			ДетальноОписаниеОшибки = ДетальноОписаниеОшибки + Символы.ПС
				+ "ошибка (" + СокрЛП(РезультатМарки.Сообщение) + ") проверки ККТ для марки "
				+ МаркаBase64;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(РезультатМарки.Предупреждение) Тогда
			ЕстьПредупреждения = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Итог.ПоВсемМаркамПроведенаПроверка = Истина;
	Итог.ВсеМаркиПриняты = ВсеПриняты;
	Итог.ЕстьПредупреждения = ЕстьПредупреждения;
	Итог.КодОшибки = КодОшибкиИтог;
	Итог.Сообщение = СокрЛП(ДетальноОписаниеОшибки);
	
	Возврат Итог;
	
КонецФункции

// Основная функция проверки одной марки на ККТ (ОИСМ).
// Модальная: паузы через Предупреждение, результат возвращается напрямую.
//
// Параметры:
//  МаркаBase64           — код маркировки в Base64;
//  ЭтоВозврат            — Истина для чека возврата;
//  ЭтоРозливнойТовар     — Истина для розливной маркировки;
//  РозливнойТоварОстатки — Истина для розливной маркировки;
//  Настройки             — Неопределено → ПолучитьНастройки()
//
// Возвращает РезультатПроверкиМарки:
//  код ошибки, описание ошибки, планируемый статус марки,
//  json результата проверки, предупреждение (нет интернета / ОИСМ не отвечает).
//
// Сценарии исхода (по убыванию «успешности»):
//  1) марка прошла проверку и принята;
//  2) марка прошла проверку и принята с предупреждением;
//  3) марка не прошла проверку;
//  4) ошибка при проверке / принятии;
//  5) превышено число опросов статуса.
// Повторы при ошибках ТС ПИоТ (403/407/410) — внутри шагов начала/опроса/принятия.
// Повтор при 401 (процедура проверки КМ уже запущена): отмена и повтор begin
// (401 может прийти и на begin, и только при опросе статуса).
//
&НаКлиенте
Функция ПроверитьМаркуНаККТ(МаркаBase64, ЭтоВозврат = Ложь, ЭтоРозливнойТовар = Ложь, РозливнойТоварОстатки = Ложь, Настройки = Неопределено)
	
	Если Настройки = Неопределено Тогда
		Настройки = ПолучитьНастройки();
	КонецЕсли;
	
	РезультатПодключения = ПодключитьККТ(Настройки);
	Если НЕ РезультатПодключения.Успех Тогда
		Возврат РезультатПроверкиМаркиСОшибкой(
			Неопределено,
			РезультатПодключения.КодОшибки,
			РезультатПодключения.Сообщение,
			"");
	КонецЕсли;
	
	ПланируемыйСтатусМарки = ПолучитьПланируемыйСтатусМарки(ЭтоВозврат, ЭтоРозливнойТовар, РозливнойТоварОстатки);
	МаксПопыток = МаксимальноеЧислоПопытокТСПиОТ();
	
	Для НомерПопытки = 1 По МаксПопыток Цикл
		
		ЕстьЕщёПопытка = НомерПопытки < МаксПопыток;
		
		// --- шаг 1: beginMarkingCodeValidation ---
		РезультатНачала = НачатьПроверкуМаркиНаККТ(МаркаBase64, ПланируемыйСтатусМарки);
		Если НЕ РезультатНачала.Успех Тогда
			
			// 401: процедура проверки КМ уже запущена — отменить и начать заново
			Если РезультатНачала.КодОшибки = 401 И ЕстьЕщёПопытка Тогда
				ОтменитьПроверкуМарки();
				Продолжить;
			КонецЕсли;
			
			Если НужноПовторитьИзЗаТСПиОТ(РезультатНачала.КодОшибки, ЕстьЕщёПопытка) Тогда
				ОжидатьОтветаТСПиОТ();
				Продолжить;
			КонецЕсли;
			
			// сценарий 4: ошибка при проверке
			Возврат РезультатПроверкиМаркиСОшибкой(
				ПланируемыйСтатусМарки,
				РезультатНачала.КодОшибки,
				РезультатНачала.Сообщение,
				РезультатНачала.ВходящийJSON);
			
		КонецЕсли;
		
		// --- шаг 2: getMarkingCodeValidationStatus до ready ---
		РезультатОпроса = ДождатьсяРезультатаПроверкиМаркиНаККТ(Настройки, ЕстьЕщёПопытка);
		Если РезультатОпроса.НуженПовторНачала Тогда
			Продолжить;
		КонецЕсли;
		Если РезультатОпроса.Ошибка Тогда
			// сценарий 4: ошибка при проверке
			Возврат РезультатПроверкиМаркиСОшибкой(
				ПланируемыйСтатусМарки,
				РезультатОпроса.КодОшибки,
				РезультатОпроса.Сообщение,
				РезультатОпроса.JSON);
		КонецЕсли;
		Если НЕ РезультатОпроса.Готово Тогда
			// сценарий 5: превышено число опросов статуса
			ОтменитьПроверкуМарки();
			Возврат РезультатПроверкиМаркиСОшибкой(
				ПланируемыйСтатусМарки,
				0,
				"Превышено максимальное число опросов статуса проверки марки",
				"");
		КонецЕсли;
		
		// --- шаг 3: разбор ready-ответа ---
		Результат = РезультатПроверкиМаркиУспех(ПланируемыйСтатусМарки, РезультатОпроса.JSON);
		
		Если Результат.Успех Тогда
			
			// --- шаг 4: acceptMarkingCode ---
			РезультатПринятия = ПринятьМаркуНаККТ();
			Если НЕ РезультатПринятия.Успех Тогда
				
				Если НужноПовторитьИзЗаТСПиОТ(РезультатПринятия.КодОшибки, ЕстьЕщёПопытка) Тогда
					ОтменитьПроверкуМарки();
					ОжидатьОтветаТСПиОТ();
					Продолжить;
				КонецЕсли;
				
				// сценарий 4: ошибка при принятии
				ОтменитьПроверкуМарки();
				Результат.Успех = Ложь;
				Результат.КодОшибки = РезультатПринятия.КодОшибки;
				Результат.Сообщение = РезультатПринятия.Сообщение;
				Возврат Результат;
				
			КонецЕсли;
			
			// сценарий 1: принята / сценарий 2: принята с предупреждением
			// (отличие — заполненность Результат.Предупреждение)
			Возврат Результат;
			
		КонецЕсли;
		
		// сценарий 3: марка не прошла проверку
		ОтменитьПроверкуМарки();
		Возврат Результат;
		
	КонецЦикла;
	
	Результат = НовыйРезультатПроверкиМаркиНаККТ();
	Результат.ПланируемыйСтатусМарки = ПланируемыйСтатусМарки;
	Результат.Сообщение = "Не удалось выполнить проверку марки";
	Возврат Результат;
	
КонецФункции

//
&НаКлиенте
Функция РазобратьОтветПроверкиМаркиНаККТ(ТекстJSON)
	
	Результат = Новый Структура;
	Результат.Вставить("Принять", Ложь);
	Результат.Вставить("ПроверенаНаОИСМ", ЛОЖЬ);
	Результат.Вставить("Сообщение", "");
	
	Ответ = ПрочитатьJSONВСтруктуру(ТекстJSON);
	
	Если НЕ Ответ.ready Тогда
		Результат.Сообщение = "Результат проверки ещё не готов";
		Возврат Результат;
	КонецЕсли;
	
	Если (Ответ.driverError.code = 421) или (Ответ.driverError.code = 402) тогда
		Результат.Принять = ИСТИНА;
		Результат.ПроверенаНаОИСМ = Ложь;
		Результат.Сообщение = Ответ.driverError.description;
		Возврат Результат;
	конецЕсли;

	Если (Ответ.driverError.code <> 0)
	Тогда //истёк таймаут проверки маркировки
		Результат.Сообщение = Ответ.driverError.description;
		Возврат Результат;
	КонецЕсли;  
		
	ОнлайнПроверка = Ответ.onlineValidation;
	Сведения = ОнлайнПроверка.itemInfoCheckResult;
	
	Если ОнлайнПроверка.markOperatorResponseResult <> "correct" Тогда
		Результат.Сообщение = "Указанный в запросе код маркировки имеет некорректный формат (не распознан);";
		Если ОнлайнПроверка.markOperatorResponseResult = "incorrect" Тогда
			Результат.Сообщение = "Запрос имеет некорректный формат";
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	// Код действительно проверен, и результат отрицательный.
	Если Сведения.imcCheckFlag
		И НЕ Сведения.imcCheckResult Тогда
		
		Результат.Сообщение = "Код маркировки не прошёл проверку";
		Возврат Результат;
		
	КонецЕсли;
	
	Если НЕ Сведения.imcStatusInfo Тогда
		Результат.Принять = ИСТИНА;
		Результат.ПроверенаНаОИСМ = Ложь;
		Результат.Сообщение = ?(
				Ответ.sentImcRequest,
				"Запрос отправлен, но ответ ОИСМ не получен",
				"Не удалось отправить запрос в ОИСМ");
		Возврат Результат;
	КонецЕсли;
	
	СтатусТовара = ОнлайнПроверка.markOperatorItemStatus;
	
	Если СтатусТовара = "itemEstimatedStatusCorrect" Тогда
		Результат.Принять = Истина;
		Результат.ПроверенаНаОИСМ = Истина;
		Результат.Сообщение = "Код маркировки успешно проверен";
		Возврат Результат;
	КонецЕсли;
	
	Если СтатусТовара = "itemSaleStopped" Тогда
		Результат.ПроверенаНаОИСМ = ИСТИНА;
		Результат.Сообщение = "Оборот товара приостановлен";
		Возврат Результат;
	КонецЕсли;
	
	Результат.ПроверенаНаОИСМ = ИСТИНА;
	Результат.Сообщение = "Планируемый статус товара некорректен";
	Возврат Результат;
	
КонецФункции


#Область ОсновныеОперации

// Пробитие чека: один ОбъектДрайвераАТОЛ на все марки и печать.
//
&НаКлиенте
Функция ПробитьЧек(ДанныеЧека, Настройки = Неопределено) Экспорт
	
	Если Настройки = Неопределено Тогда
		Настройки = ПолучитьНастройки();
	КонецЕсли;
	
	РезульатПроверкиМарок = ПолучитьИлиВыполнитьПроверкиМарок(ДанныеЧека, Настройки);
	Если РезульатПроверкиМарок.КодОшибки <> 0
		ИЛИ РезульатПроверкиМарок.ПоВсемМаркамПроведенаПроверка = Ложь
		ИЛИ РезульатПроверкиМарок.ВсеМаркиРазрешеныКПродаже = Ложь Тогда
		Возврат РезульатПроверкиМарок;
	КонецЕсли;
	
	РезультатПодключения = ПодключитьККТ(Настройки);
	Если НЕ РезультатПодключения.Успех Тогда
		ДобавитьРезультатыПроверокМарокВОтвет(РезультатПодключения, РезульатПроверкиМарок);
		Возврат РезультатПодключения;
	КонецЕсли;
	
	JSONЧека = СформироватьJSONЧека(ДанныеЧека, РезульатПроверкиМарок, Настройки);
	
	ЭмуляцияККТ = НастройкаВключена(Настройки, "ЭмуляцияККТ");
	НеПробиватьЧек = НастройкаВключена(Настройки, "НеПробиватьЧек");
	
	Если ЭмуляцияККТ И НеПробиватьЧек Тогда
		ЗаписатьЛог("Пробитие чека", "WARNING",
			"Оба режима включены: приоритет у эмуляции, «Не пробивать чек» игнорируется");
	КонецЕсли;
	
	// Режим без фискализации: JSON в лог, processJson с чеком не вызываем, cancelReceipt.
	Если НеПробиватьЧек И НЕ ЭмуляцияККТ Тогда
		
		ЗаписатьЛог("Пробитие чека", "REQUEST (SKIPPED)", JSONЧека);
		
		РезультатОтмены = ОтменитьЧек(Настройки);
		Если НЕ РезультатОтмены.Успех Тогда
			ДобавитьРезультатыПроверокМарокВОтвет(РезультатОтмены, РезульатПроверкиМарок);
			Возврат РезультатОтмены;
		КонецЕсли;
		
		Результат = НовыйРезультатОперации();
		Результат.Успех = Истина;
		Результат.Сообщение =
			"Проверки пройдены. Чек не пробит (режим без печати). Выполнена отмена чека.";
		Результат.Вставить("ЧекНеПробит", Истина);
		ДобавитьРезультатыПроверокМарокВОтвет(Результат, РезульатПроверкиМарок);
		ЗаписатьЛог("Пробитие чека", "CANCEL RECEIPT", Результат.Сообщение);
		Возврат Результат;
		
	КонецЕсли;
	
	РезультатВыполненияJSONЗадания = ВыполнитьJSONАТОЛ(JSONЧека, "Пробитие чека", Настройки);
	Если НЕ РезультатВыполненияJSONЗадания.Успех Тогда
		ДобавитьРезультатыПроверокМарокВОтвет(РезультатВыполненияJSONЗадания, РезульатПроверкиМарок);
		Возврат РезультатВыполненияJSONЗадания;
	КонецЕсли;
	
	РезультатОперации = РазобратьJSONОтветФискальныеПараметрыДокументаККТ(РезультатВыполненияJSONЗадания.ВходящийJSON);
	ДобавитьРезультатыПроверокМарокВОтвет(РезультатОперации, РезульатПроверкиМарок);
	
	Возврат РезультатОперации;
	
КонецФункции

// Опрос ККТ + РР без печати чека.
// МассивМарокККТ / МассивМарокРР — если Неопределено, берутся все нужные из ДанныеЧека.
// Пустые массивы: опрос не выполняется (итог успешен).
//
&НаКлиенте
Функция ВыполнитьПроверкиМарокЧека(ДанныеЧека, Настройки = Неопределено,
		МассивМарокККТ = Неопределено, МассивМарокРР = Неопределено) Экспорт
	
	Если Настройки = Неопределено Тогда
		Настройки = ПолучитьНастройки();
	КонецЕсли;
	
	ЭтоВозврат = ЭтоЧекВозврата(ДанныеЧека);
	
	Если МассивМарокККТ = Неопределено Тогда
		МассивМарокККТ = ПолучитьВсеМаркиДляПроверкиНаККТ(ДанныеЧека);
	КонецЕсли;
	Если МассивМарокРР = Неопределено Тогда
		МассивМарокРР = ПолучитьВсеМаркиДляПроверкиПоРР(ДанныеЧека);
	КонецЕсли;
	
	ЗаписатьЛог("Проверка марок", "INFO",
		СтрШаблон("ККТ: %1, РР: %2", МассивМарокККТ.Количество(), МассивМарокРР.Количество()));
	
	РезультатПроверкиМарки = ПроверитьМаркиНаККТ(МассивМарокККТ, ЭтоВозврат, Настройки);
	РезультатПроверкиМаркиПоРР = ПроверитьМаркиПоРР(МассивМарокРР, Настройки);
	
	Возврат ОбъединитьРезультатыПроверкиМарок(РезультатПроверкиМарки, РезультатПроверкиМаркиПоРР);
	
КонецФункции

// Прокинуть массивы результатов ККТ/РР в ответ операции (для записи в таблицу формы).
//
&НаКлиенте
Процедура ДобавитьРезультатыПроверокМарокВОтвет(РезультатОперации, РезультатПроверкиМарок)
	
	Если ТипЗнч(РезультатОперации) <> Тип("Структура")
		ИЛИ ТипЗнч(РезультатПроверкиМарок) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если РезультатПроверкиМарок.Свойство("РезультатыККТ") Тогда
		РезультатОперации.Вставить("РезультатыККТ", РезультатПроверкиМарок.РезультатыККТ);
	КонецЕсли;
	Если РезультатПроверкиМарок.Свойство("РезультатыРР") Тогда
		РезультатОперации.Вставить("РезультатыРР", РезультатПроверкиМарок.РезультатыРР);
	КонецЕсли;
	
КонецПроцедуры

