// Тестовый JSON ответа getShiftStatus.
// СостояниеСмены: "открыта", "закрыта", "истекла".
//
&НаКлиенте
Функция ПолучитьМокJSONСостоянияСмены(СостояниеСмены = "закрыта") Экспорт
	
	Если СостояниеСмены = "открыта" Тогда
		Состояние = "opened";
	ИначеЕсли СостояниеСмены = "истекла" Тогда
		Состояние = "expired";
	Иначе
		Состояние = "closed";
	КонецЕсли;
	
	СтатусСмены = Новый Структура;
	СтатусСмены.Вставить("documentsCount", 2);
	СтатусСмены.Вставить("expiredTime", "2026-07-14T13:52:59+03:00");
	СтатусСмены.Вставить("number", 152);
	СтатусСмены.Вставить("state", Состояние);
	
	Возврат ЗаписатьСтруктуруВJSON(Новый Структура("shiftStatus", СтатусСмены));
	
КонецФункции

// Из ответа getShiftStatus: Открыта, Превышены24Часа.
// state: opened / closed / expired.
//
&НаКлиенте
Функция РазобратьJSONОтветСтатусаСмены(JSONОтвет)
	
	Результат = НовыйРезультатОперации();
	Результат.Вставить("Открыта", Ложь);
	Результат.Вставить("Превышены24Часа", Ложь);
	
	Ответ = РазобратьОтветJSONАТОЛ(JSONОтвет);
	Если Ответ = Неопределено ИЛИ НЕ Ответ.Свойство("shiftStatus") Тогда
		Результат.Успех = Ложь;
		Результат.Сообщение = "Не удалось разобрать json ответ статуса смены";
		Возврат Результат;
	КонецЕсли;
	
	СтатусСмены = Ответ.shiftStatus;
	Состояние = "";
	Если ТипЗнч(СтатусСмены) = Тип("Структура") И СтатусСмены.Свойство("state") Тогда
		Состояние = СтатусСмены.state;
	КонецЕсли;
	
	Если Состояние = "opened" Тогда
		Результат.Открыта = Истина;
	ИначеЕсли Состояние = "expired" Тогда
		Результат.Открыта = Истина;
		Результат.Превышены24Часа = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

