#КонецОбласти

#Область ИсполнениеJSONАТОЛ

// Единственная точка вызова processJson для всех JSON-заданий АТОЛ.
// При ЭмуляцияККТ: processJson вызывается (если драйвер есть), ответ для логики — мок.
//
&НаКлиенте
Функция ВыполнитьJSONАТОЛ(ТекстJSON, Этап, Настройки = Неопределено) Экспорт
	
	Результат = НовыйРезультатОперации();
	Результат.ИсходящийJSON = ТекстJSON;
	
	ЗаписатьЛог(Этап, "REQUEST", ТекстJSON);
	
	Если Настройки = Неопределено Тогда
		Настройки = ПолучитьНастройки();
	КонецЕсли;
	
	Если НастройкаВключена(Настройки, "ЭмуляцияККТ") Тогда
		
		ТекстОтветаДрайвера = "";
		КодОшибки = 0;
		ТекстОшибкиДрайвера = "";
		КодВыполнения = 0;
		
		Если ОбъектДрайвераАТОЛ <> Неопределено Тогда
			Попытка
				ОбъектДрайвераАТОЛ.setParam(ОбъектДрайвераАТОЛ.LIBFPTR_PARAM_JSON_DATA, ТекстJSON);
				КодВыполнения = ОбъектДрайвераАТОЛ.processJson();
				КодОшибки = ОбъектДрайвераАТОЛ.errorCode();
				ТекстОшибкиДрайвера = ОбъектДрайвераАТОЛ.errorDescription();
				ТекстОтветаДрайвера = ОбъектДрайвераАТОЛ.getParamString(
						ОбъектДрайвераАТОЛ.LIBFPTR_PARAM_JSON_DATA);
			Исключение
				КодОшибки = -1;
				ТекстОшибкиДрайвера = ОписаниеОшибки();
				ЗаписатьЛог(Этап, "ERROR (IGNORED)", ТекстОшибкиДрайвера);
			КонецПопытки;
		Иначе
			ЗаписатьЛог(Этап, "ERROR (IGNORED)", "ОбъектДрайвераАТОЛ не создан");
		КонецЕсли;
		
		Если КодВыполнения <> 0 ИЛИ КодОшибки <> 0 Тогда
			ЗаписатьЛог(Этап, "ERROR (IGNORED)",
				"code=" + Строка(КодОшибки) + "; " + ТекстОшибкиДрайвера
				+ "; driverResponse=" + ТекстОтветаДрайвера);
		КонецЕсли;
		
		ТипЗадания = ИзвлечьТипJSONЗадания(ТекстJSON);
		ТекстОтвета = ПолучитьМокОтветJSONАТОЛ(ТипЗадания, ТекстJSON, Этап);
		
		Результат.Успех = Истина;
		Результат.КодОшибки = 0;
		Результат.Сообщение = "";
		Результат.ВходящийJSON = ТекстОтвета;
		ЗаписатьЛог(Этап, "RESPONSE (MOCK)", ТекстОтвета);
		Возврат Результат;
		
	КонецЕсли;
	
	ОбъектДрайвераАТОЛ.setParam(ОбъектДрайвераАТОЛ.LIBFPTR_PARAM_JSON_DATA, ТекстJSON);
	КодВыполнения = ОбъектДрайвераАТОЛ.processJson();
	КодОшибки = ОбъектДрайвераАТОЛ.errorCode();
	ТекстОшибкиДрайвера = ОбъектДрайвераАТОЛ.errorDescription();
	ТекстОтвета = ОбъектДрайвераАТОЛ.getParamString(ОбъектДрайвераАТОЛ.LIBFPTR_PARAM_JSON_DATA);
	
	Результат.ВходящийJSON = ТекстОтвета;
	ЗаписатьЛог(Этап, "RESPONSE", ТекстОтвета);
	
	Если КодВыполнения <> 0 Тогда
		Результат.Успех = Ложь;
		Результат.КодОшибки = КодОшибки;
		Результат.Сообщение = ТекстОшибкиДрайвера;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Поле type корневого JSON-задания АТОЛ (openShift, sell, …).
//
&НаКлиенте
Функция ИзвлечьТипJSONЗадания(ТекстJSON) Экспорт
	
	Попытка
		Данные = ПрочитатьJSONВСтруктуру(ТекстJSON);
		Если Данные = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		ТипДанных = ТипЗнч(Данные);
		Если ТипДанных = Тип("Структура") Тогда
			Если Данные.Свойство("type") Тогда
				Возврат Строка(Данные.type);
			КонецЕсли;
		ИначеЕсли ТипДанных = Тип("Соответствие") Тогда
			ЗначениеТипа = Данные.Получить("type");
			Если ЗначениеТипа <> Неопределено Тогда
				Возврат Строка(ЗначениеТипа);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Возврат "";
	КонецПопытки;
	
	Возврат "";
	
КонецФункции

// Роутер мок-ответов АТОЛ по type задания.
//
&НаКлиенте
Функция ПолучитьМокОтветJSONАТОЛ(ТипЗадания, ТекстJSON, Этап = "") Экспорт
	
	Если ТипЗадания = "getShiftStatus" Тогда
		Возврат ПолучитьМокJSONСостоянияСмены("открыта");
	ИначеЕсли ТипЗадания = "openShift" Тогда
		Возврат ПолучитьМокJSONОткрытияСмены();
	ИначеЕсли ТипЗадания = "closeShift" Тогда
		Возврат ПолучитьМокJSONЗакрытияСмены();
	ИначеЕсли ТипЗадания = "beginMarkingCodeValidation" Тогда
		Возврат ПолучитьМокJSONНачалаПроверкиМарки("успех");
	ИначеЕсли ТипЗадания = "getMarkingCodeValidationStatus" Тогда
		Возврат ПолучитьМокJSONСтатусаПроверкиМарки(Истина, "принять");
	ИначеЕсли ТипЗадания = "acceptMarkingCode" Тогда
		Возврат ПолучитьМокJSONПринятияМарки();
	ИначеЕсли ТипЗадания = "sell" ИЛИ ТипЗадания = "sellReturn" Тогда
		Возврат ПолучитьМокОтветПробитияЧека(ТекстJSON);
	КонецЕсли;
	
	// reportX, continuePrint, cancel/decline/clear marking, неизвестный type
	Возврат "{}";
	
КонецФункции

&НаКлиенте
Функция РазобратьОтветJSONАТОЛ(ТекстJSON) Экспорт
	
	Попытка
		Возврат ПрочитатьJSONВСтруктуру(ТекстJSON);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

#КонецОбласти
