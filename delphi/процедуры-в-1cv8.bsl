		ИЛИ НЕ РезультатыПроверок.Свойство("РезультатыРР") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого Элемент Из РезультатыПроверок.РезультатыРР Цикл
		Если Элемент.Свойство("МаркаBase64") И Элемент.МаркаBase64 = МаркаBase64 Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Значение с формы → код taxationType АТОЛ (osn, usnIncome, …).
// Принимает код АТОЛ как есть либо число/строку тега 1055: 1…5.
//
&НаКлиенте
Функция КодСистемыНалогообложенияАТОЛ(СистемаНалогообложения)
	
	Если ТипЗнч(СистемаНалогообложения) = Тип("Число") Тогда
		Код = СистемаНалогообложения;
	Иначе
		Текст = НРег(СокрЛП(Строка(СистемаНалогообложения)));
		Если Текст = "osn"
			ИЛИ Текст = "usnincome"
			ИЛИ Текст = "usnincomeoutcome"
			ИЛИ Текст = "esn"
			ИЛИ Текст = "patent" Тогда
			Если Текст = "usnincome" Тогда
				Возврат "usnIncome";
			ИначеЕсли Текст = "usnincomeoutcome" Тогда
				Возврат "usnIncomeOutcome";
			КонецЕсли;
			Возврат Текст;
		КонецЕсли;
		Попытка
			Код = Число(Текст);
		Исключение
			Возврат Строка(СистемаНалогообложения);
		КонецПопытки;
	КонецЕсли;
	
	Если Код = 1 Тогда
		Возврат "osn";
	ИначеЕсли Код = 2 Тогда
		Возврат "usnIncome";
	ИначеЕсли Код = 3 Тогда
		Возврат "usnIncomeOutcome";
	ИначеЕсли Код = 4 Тогда
		Возврат "esn";
	ИначеЕсли Код = 5 Тогда
		Возврат "patent";
	КонецЕсли;
	
	Возврат Строка(СистемаНалогообложения);
	
КонецФункции

&НаКлиенте
Функция ПолучитьМокОтветПробитияЧека(JSONОтвет, ДокументДопечатался = Истина)
	Результат = Новый Структура;
	
	ФискальныеПараметры = Новый Структура;
	ФискальныеПараметры.Вставить("fiscalDocumentSign", "1234567890");
	ФискальныеПараметры.Вставить("fiscalDocumentNumber", 1234567890);
	ФискальныеПараметры.Вставить("fiscalDocumentDateTime", "2026-01-01 12:00:00");
	ФискальныеПараметры.Вставить("fiscalReceiptNumber", 1234567890);
	ФискальныеПараметры.Вставить("fnNumber", 1234567890);
	ФискальныеПараметры.Вставить("shiftNumber", 12);
	ФискальныеПараметры.Вставить("total", 12);
	ФискальныеПараметры.Вставить("fnsUrl", "www.nalog.gov.ru");
	
	Результат.Вставить("fiscalParams", ФискальныеПараметры);
	Результат.Вставить("warnings", Новый Структура("notPrinted", "warning", ДокументДопечатался));
	Возврат ЗаписатьСтруктуруВJSON(Результат);
КонецФункции

&НаКлиенте
Функция РазобратьJSONОтветФискальныеПараметрыДокументаККТ(JSONОтвет)
	Результат = НовыйРезультатОперации();
	Результат.Вставить("ФП", "");
	Результат.Вставить("ФД", 0);
	Результат.Вставить("ДатаВремяЧека", "");
	Результат.Вставить("НомерСмены", 0);
	Результат.Вставить("НомерЧекаЗаСмену", 0);
	
	Ответ = РазобратьОтветJSONАТОЛ(JSONОтвет);
	Если Ответ = Неопределено ИЛИ НЕ Ответ.Свойство("fiscalParams") Тогда
		Результат.Успех = Ложь;
		Результат.Сообщение = "Не удалось разобрать ответ пробития чека";
		Возврат Результат;
	КонецЕсли;
	
	ФискальныеПараметры = Ответ.fiscalParams;
	
	Если ФискальныеПараметры.Свойство("shiftNumber") Тогда
		Результат.НомерСмены = Строка(ФискальныеПараметры.fiscalDocumentSign);
	КонецЕсли;
	
	Если ФискальныеПараметры.Свойство("fiscalDocumentSign") Тогда
		Результат.ФП = Строка(ФискальныеПараметры.fiscalDocumentSign);
	КонецЕсли;
	
	Если ФискальныеПараметры.Свойство("fiscalDocumentNumber") Тогда
		Результат.ФД = ФискальныеПараметры.fiscalDocumentNumber;
	КонецЕсли;
	
	Если ФискальныеПараметры.Свойство("fiscalDocumentDateTime") Тогда
		Результат.ДатаВремяЧека = ФискальныеПараметры.fiscalDocumentDateTime;
	КонецЕсли;
	
	Если ФискальныеПараметры.Свойство("fiscalReceiptNumber") Тогда
		Результат.НомерЧекаЗаСмену = ФискальныеПараметры.fiscalReceiptNumber;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

