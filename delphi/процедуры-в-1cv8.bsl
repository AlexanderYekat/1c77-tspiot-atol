// Тестовый JSON ответа getMarkingCodeValidationStatus.
// Варианты (по КлассифицироватьРезультатПроверки / retry ТСПиОТ):
//  "принять"                 → Принять
//  "неготов"                 → НеПринимать (результат ещё не готов)
//  "ошибкаДрайвера"          → НеПринимать (обычная ошибка драйвера)
//  "ошибкаТСПиОТ"            → driverError с кодом ТСПиОТ (см. КодОшибкиТСПиОТ)
//  "ошибкаТСПиОТ403"         → 403, процедура проверки КМ прервана
//  "ошибкаТСПиОТ407"         → 407, работа с маркировкой временно заблокирована
//  "ошибкаТСПиОТ410"         → 410, неверное состояние
//  "некорректныйЗапрос"      → НеПринимать
//  "проверкаОтрицательная"   → НеПринимать
//  "предупреждениеОИСМ"      → ПринятьСПредупреждением (запрос отправлен)
//  "предупреждениеНетЗапроса"→ ПринятьСПредупреждением (запрос не отправлен)
//  "оборотПриостановлен"     → НеПринимать
//  "статусНекорректен"       → НеПринимать
//
// КодОшибкиТСПиОТ — для варианта "ошибкаТСПиОТ" (по умолчанию 407; допустимы 403, 407, 410).
//
&НаКлиенте
Функция ПолучитьМокJSONСтатусаПроверкиМарки(РезульатПроверкиГотов = Истина, Вариант = "принять", КодОшибкиТСПиОТ = 407) Экспорт
	
	Сведения = Новый Структура;
	Сведения.Вставить("imcCheckFlag", Истина);
	Сведения.Вставить("imcCheckResult", Истина);
	Сведения.Вставить("imcStatusInfo", Истина);
	Сведения.Вставить("ecrStandAloneFlag", Истина);
	
	ОтветОператора = Новый Структура;
	ОтветОператора.Вставить("responseStatus", Истина);
	ОтветОператора.Вставить("itemStatusCheck", Истина);
	
	ОнлайнПроверка = Новый Структура;
	ОнлайнПроверка.Вставить("itemInfoCheckResult", Сведения);
	ОнлайнПроверка.Вставить("markOperatorItemStatus", "itemEstimatedStatusCorrect");
	ОнлайнПроверка.Вставить("markOperatorResponse", ОтветОператора);
	ОнлайнПроверка.Вставить("markOperatorResponseResult", "correct");
	ОнлайнПроверка.Вставить("imcType", "imcFmVerifyCode88");
	ОнлайнПроверка.Вставить("imcBarcode",
		"MDEwMjkwMDAwMDQ3NTgzMDIxTWRFZng6WHA2WUZkNx05MTgwMjkdOTJhUUlRa0k3b0hYbXpHL21kS3h6Q1VDS1RKSFhvQk9EZG1DZE01azhRajdnYVpWMnhibjY2eEJYR0lLcnRmdnFQSU5BMmprYmp5ajMvTytreTZvdTFOQT09");
	ОнлайнПроверка.Вставить("imcModeProcessing", 0);
	
	ОшибкаДрайвера = Новый Структура;
	ОшибкаДрайвера.Вставить("code", 0);
	ОшибкаДрайвера.Вставить("error", "");
	ОшибкаДрайвера.Вставить("description", "");
	
	Результат = Новый Структура;
	Результат.Вставить("ready", РезульатПроверкиГотов);
	Результат.Вставить("sentImcRequest", Истина);
	Результат.Вставить("driverError", ОшибкаДрайвера);
	Результат.Вставить("onlineValidation", ОнлайнПроверка);
	
	Если Вариант = "неготов" Тогда
		
		Результат.ready = Ложь;
		
	ИначеЕсли Вариант = "ошибкаДрайвера" Тогда
		
		ОшибкаДрайвера.code = 1;
		ОшибкаДрайвера.error = "MARKING_ERROR";
		ОшибкаДрайвера.description = "Ошибка проверки кода маркировки";
		
	ИначеЕсли Вариант = "ошибкаТСПиОТ" Тогда
		
		ЗаполнитьМокОшибкуТСПиОТ(ОшибкаДрайвера, КодОшибкиТСПиОТ);
		
	ИначеЕсли Вариант = "ошибкаТСПиОТ403" Тогда
		
		ЗаполнитьМокОшибкуТСПиОТ(ОшибкаДрайвера, 403);
		
	ИначеЕсли Вариант = "ошибкаТСПиОТ407" Тогда
		
		ЗаполнитьМокОшибкуТСПиОТ(ОшибкаДрайвера, 407);
		
	ИначеЕсли Вариант = "ошибкаТСПиОТ410" Тогда
		
		ЗаполнитьМокОшибкуТСПиОТ(ОшибкаДрайвера, 410);
		
	ИначеЕсли Вариант = "некорректныйЗапрос" Тогда
		
		ОнлайнПроверка.markOperatorResponseResult = "incorrect";
		
	ИначеЕсли Вариант = "проверкаОтрицательная" Тогда
		
		Сведения.imcCheckFlag = Истина;
		Сведения.imcCheckResult = Ложь;
		
	ИначеЕсли Вариант = "предупреждениеОИСМ" Тогда
		
		Результат.sentImcRequest = Истина;
		Сведения.imcStatusInfo = Ложь;
		
	ИначеЕсли Вариант = "предупреждениеНетЗапроса" Тогда
		
		Результат.sentImcRequest = Ложь;
		Сведения.imcStatusInfo = Ложь;
		
	ИначеЕсли Вариант = "оборотПриостановлен" Тогда
		
		ОнлайнПроверка.markOperatorItemStatus = "itemStatusCheckSuspended";
		
	ИначеЕсли Вариант = "статусНекорректен" Тогда
		
		ОнлайнПроверка.markOperatorItemStatus = "itemEstimatedStatusIncorrect";
		
	КонецЕсли;
	
	Возврат ЗаписатьСтруктуруВJSON(Результат);
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьМокОшибкуТСПиОТ(ОшибкаДрайвера, КодОшибки)
	
	ОшибкаДрайвера.code = КодОшибки;
	
	Если КодОшибки = 403 Тогда
		ОшибкаДрайвера.error = "MARKING_CODE_VALIDATION_CANCELED";
		ОшибкаДрайвера.description = "Процедура проверки КМ прервана";
	ИначеЕсли КодОшибки = 410 Тогда
		ОшибкаДрайвера.error = "INVALID_STATE";
		ОшибкаДрайвера.description = "Неверное состояние";
	Иначе
		ОшибкаДрайвера.code = 407;
		ОшибкаДрайвера.error = "MARKING_WORK_TEMPORARY_BLOCKED";
		ОшибкаДрайвера.description = "Работа с маркированными товарами временно заблокирована";
	КонецЕсли;
	
КонецПроцедуры

