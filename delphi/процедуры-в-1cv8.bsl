//
// Получить состояние смены
// Параметры:
// Настройки - настройки подключения к ККТ
// Возвращает:
// РезультатОперации - результат операции
// РезультатОперации.Открыта - открыта ли смена
// РезультатОперации.Превышены24Часа - превышены ли 24 часа
&НаКлиенте
Функция ПолучитьСостояниеСмены(Настройки = Неопределено) Экспорт
	
	РезультатПодключения = ПодключитьККТ(Настройки);
	Если НЕ РезультатПодключения.Успех Тогда
		Возврат РезультатПодключения;
	КонецЕсли;
	
	JSON = СформироватьJSONСостоянияСмены();
	РезультатВыполненияJSONЗадания = ВыполнитьJSONАТОЛ(JSON, "Состояние смены");
	Если НЕ РезультатВыполненияJSONЗадания.Успех Тогда
		Возврат РезультатВыполненияJSONЗадания;
	КонецЕсли;
	
	Результат = РазобратьJSONОтветСтатусаСмены(РезультатВыполненияJSONЗадания.ВходящийJSON);
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ОтменитьЧек(Настройки = Неопределено) Экспорт
	
	Если Настройки = Неопределено Тогда
		Настройки = ПолучитьНастройки();
	КонецЕсли;
	
	ЭмуляцияККТ = НастройкаВключена(Настройки, "ЭмуляцияККТ");
	
	РезультатОперации = ПодключитьККТ(Настройки);
	Если НЕ РезультатОперации.Успех Тогда
		Возврат РезультатОперации;
	КонецЕсли;
	
	РезультатОперации = НовыйРезультатОперации();
	
	Если ОбъектДрайвераАТОЛ = Неопределено Тогда
		Если ЭмуляцияККТ Тогда
			ЗаписатьЛог("Отмена чека", "ERROR (IGNORED)",
				"ОбъектДрайвераАТОЛ не создан, cancelReceipt пропущен");
			РезультатОперации.Сообщение = "Эмуляция: cancelReceipt пропущен";
			Возврат РезультатОперации;
		КонецЕсли;
		РезультатОперации.Успех = Ложь;
		РезультатОперации.Сообщение = "ОбъектДрайвераАТОЛ не создан";
		Возврат РезультатОперации;
	КонецЕсли;
	
	Попытка
		ОбъектДрайвераАТОЛ.cancelReceipt();
		КодОшибки = ОбъектДрайвераАТОЛ.errorCode();
		ТекстОшибкиДрайвера = ОбъектДрайвераАТОЛ.errorDescription();
		
		ЗаписатьЛог("Отмена чека", "", "");
		
		Если КодОшибки <> 0 Тогда
			Если ЭмуляцияККТ Тогда
				ЗаписатьЛог("Отмена чека", "ERROR (IGNORED)",
					"code=" + Строка(КодОшибки) + "; " + ТекстОшибкиДрайвера);
			Иначе
				РезультатОперации.Успех = Ложь;
				РезультатОперации.КодОшибки = КодОшибки;
				РезультатОперации.Сообщение = ТекстОшибкиДрайвера;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ТекстИсключения = ОписаниеОшибки();
		Если ЭмуляцияККТ Тогда
			ЗаписатьЛог("Отмена чека", "ERROR (IGNORED)", ТекстИсключения);
		Иначе
			Возврат РезультатИсключения(ТекстИсключения);
		КонецЕсли;
	КонецПопытки;
	
	Возврат РезультатОперации;
	
КонецФункции

#КонецОбласти



#Область ВзаимодействиеСДрайверомАТОЛ

// Создание COM-объекта AddIn.Fptr10. Вызывать один раз при открытии формы.
//
&НаКлиенте
Функция ИнициализироватьДрайверАТОЛ() Экспорт
	
	Если ОбъектДрайвераАТОЛ <> Неопределено Тогда
		Возврат НовыйРезультатОперации();
	КонецЕсли;
	
	Результат = НовыйРезультатОперации();
	
	Попытка
		ОбъектДрайвераАТОЛ = Новый COMОбъект("AddIn.Fptr10");
	Исключение
		Результат = РезультатИсключения("Драйвер АТОЛ v10 не установлен: " + ОписаниеОшибки());
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Настройки подключения с формы (реквизиты формы → структура).
// Чтение через ЭтотОбъект["…"] — компилятор не требует объявления каждого имени
// как переменной модуля (ошибка «Переменная не определена» при рассинхроне XML/EPF).
// Сами реквизиты должны быть в Form.xml (Attributes).
//
&НаКлиенте
Функция ПолучитьНастройки() Экспорт
	
	Настройки = Новый Структура;
	Настройки.Вставить("ТипПодключения", ЗначениеРеквизитаФормы("РеквизитТипПодключения", "usb"));
	Настройки.Вставить("НомерCOM", ЗначениеРеквизитаФормы("РеквизитНомерCOM", 3));
	Настройки.Вставить("АдресIP", ЗначениеРеквизитаФормы("РеквизитАдресIP", ""));
	Настройки.Вставить("ПортIP", ЗначениеРеквизитаФормы("РеквизитПортIP", 5555));
	Настройки.Вставить("АдресСервераУдаленногоДоступа", ЗначениеРеквизитаФормы("РеквизитАдресСервераУдаленногоДоступа", ""));
	Настройки.Вставить("ИмяКассира", ЗначениеРеквизитаФормы("РеквизитИмяКассира", "Кассир"));
	Настройки.Вставить("ИННКассира", ЗначениеРеквизитаФормы("РеквизитИННКассира", ""));
	Настройки.Вставить("ПисатьЛог", ЗначениеРеквизитаФормы("РеквизитПисатьЛог", Ложь));
	Настройки.Вставить("УровеньОтладки", ЗначениеРеквизитаФормы("РеквизитУровеньОтладки", 0));
	Настройки.Вставить("ТаймаутПроверкиМарки", ЗначениеРеквизитаФормы("РеквизитТаймаутПроверкиМарки", 15));
	Настройки.Вставить("СистемаНалогообложения", ЗначениеРеквизитаФормы("РеквизитСистемаНалогообложения", "osn"));
	Настройки.Вставить("АдресFMUAPI", ЗначениеРеквизитаФормы("РеквизитАдресFMUAPI", "127.0.0.1"));
	Настройки.Вставить("ПортFMUAPI", ЗначениеРеквизитаФормы("РеквизитПортFMUAPI", 2578));
	Настройки.Вставить("ЭмуляцияККТ", ЗначениеРеквизитаФормы("РеквизитЭмуляцияККТ", Ложь));
	Настройки.Вставить("НеПробиватьЧек", ЗначениеРеквизитаФормы("РеквизитНеПробиватьЧек", Ложь));
	
	Возврат Настройки;
	
КонецФункции

&НаКлиенте
Процедура ПрименитьНастройкиПодключенияАТОЛ(ОбъектДрайвера, Настройки) Экспорт
	
	ТипПодключения = НРег(Настройки.ТипПодключения);
	
	Если ТипПодключения = "com" Тогда
		ОбъектДрайвера.setSingleSetting(ОбъектДрайвера.LIBFPTR_SETTING_PORT,
			Строка(ОбъектДрайвера.LIBFPTR_PORT_COM));
		ОбъектДрайвера.setSingleSetting(ОбъектДрайвера.LIBFPTR_SETTING_COM_FILE,
			СтрШаблон("COM%1", Настройки.НомерCOM));
	ИначеЕсли ТипПодключения = "ip" Тогда
		ОбъектДрайвера.setSingleSetting(ОбъектДрайвера.LIBFPTR_SETTING_PORT,
			Строка(ОбъектДрайвера.LIBFPTR_PORT_TCPIP));
		ОбъектДрайвера.setSingleSetting(ОбъектДрайвера.LIBFPTR_SETTING_IPADDRESS,
			Настройки.АдресIP);
		ОбъектДрайвера.setSingleSetting(ОбъектДрайвера.LIBFPTR_SETTING_IPPORT,
			Формат(Настройки.ПортIP, "ЧГ=0"));
	ИначеЕсли ТипПодключения = "usb" Тогда
		ОбъектДрайвера.setSingleSetting(ОбъектДрайвера.LIBFPTR_SETTING_PORT,
			Строка(ОбъектДрайвера.LIBFPTR_PORT_USB));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Настройки.АдресСервераУдаленногоДоступа) Тогда
		ОбъектДрайвера.setSingleSetting(ОбъектДрайвера.LIBFPTR_SETTING_REMOTE_SERVER_ADDR,
			Настройки.АдресСервераУдаленногоДоступа);
	КонецЕсли;
		
КонецПроцедуры

// Подключение к ККТ перед бизнес-операцией.
// Если isOpened() = Ложь — применяет настройки и вызывает open().
// Настройки: передать явно или Неопределено → ПолучитьНастройки().
//
&НаКлиенте
Функция ПодключитьККТ(Настройки = Неопределено) Экспорт
	
	Если Настройки = Неопределено Тогда
		Настройки = ПолучитьНастройки();
	КонецЕсли;
	
	Результат = ИнициализироватьДрайверАТОЛ();
	Если НЕ Результат.Успех Тогда
		Возврат РезультатПодключенияСУчётомЭмуляции(Результат, Настройки);
	КонецЕсли;
	
	Если ДрайверККТОткрыт() Тогда
		Возврат НовыйРезультатОперации();
	КонецЕсли;
	
	ПрименитьНастройкиПодключенияАТОЛ(ОбъектДрайвераАТОЛ, Настройки);
	ОбъектДрайвераАТОЛ.applySingleSettings();
	
	КодПодключения = ОбъектДрайвераАТОЛ.open();
	Если КодПодключения <> 0 Тогда
		Результат.Успех = Ложь;
		Результат.КодОшибки = ОбъектДрайвераАТОЛ.errorCode();
		Результат.Сообщение = ОбъектДрайвераАТОЛ.errorDescription();
	КонецЕсли;
	
	Возврат РезультатПодключенияСУчётомЭмуляции(Результат, Настройки);
	
КонецФункции

// При эмуляции ошибки подключения/драйвера не валят сценарий — только в лог.
//
&НаКлиенте
Функция РезультатПодключенияСУчётомЭмуляции(Результат, Настройки)
	
	Если НЕ Результат.Успех И НастройкаВключена(Настройки, "ЭмуляцияККТ") Тогда
		ЗаписатьЛог("Подключение ККТ", "ERROR (IGNORED)", Результат.Сообщение);
		Возврат НовыйРезультатОперации();
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Отключение от ККТ (close). COM-объект остаётся в памяти.
//
&НаКлиенте
Процедура ОтключитьККТ() Экспорт
	
	Если ОбъектДрайвераАТОЛ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Если ДрайверККТОткрыт() Тогда
			ОбъектДрайвераАТОЛ.close();
		КонецЕсли;
	Исключение
		// Гарантированное отключение.
	КонецПопытки;
	
КонецПроцедуры

// Полное освобождение — при закрытии формы.
//
&НаКлиенте
Процедура ОсвободитьДрайверАТОЛ() Экспорт
	
	ОтключитьККТ();
	ОбъектДрайвераАТОЛ = Неопределено;
	
КонецПроцедуры

