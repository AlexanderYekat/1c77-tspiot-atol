# Выход Inno Setup (installer_1cv77_extforms.iss)
1cv77/output/

# =============================================================================
# Delphi (delphi/)
# =============================================================================

# Каталоги сборки RAD Studio
Win32/
Win64/

# Бинарники и промежуточные файлы компилятора
*.exe
*.dll
*.bpl
*.bpi
*.dcp
*.dcu
*.drc
*.map
*.dres
*.rsm
*.tds
*.lib
*.obj
*.o
*.ocx

# Локальные / автогенерируемые файлы IDE
*.local
*.identcache
*.projdata
*.tvsconfig
*.dsk
*.dsv
*.stat
*.cfg
*.hpp

# История и бэкапы
__history/
__recovery/
*.~*

# Локальные ini (порты, эмуляция ККТ) и логи
delphi/**/*.ini
*.log

# Выход Inno Setup (installer_kktserver.iss)
delphi/output/

